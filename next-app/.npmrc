# @cloudflare/next-on-pages ยัง pin @cloudflare/workers-types ไว้ที่ v4 ขณะที่ wrangler รุ่นใหม่ขอ v5
# ทั้งคู่เป็น peerOptional และใช้ร่วมกันได้จริง แค่ npm strict-peer-deps ไม่ยอมให้ผ่าน
# บรรทัดนี้จำเป็นสำหรับ Cloudflare Pages build ด้วย (ไม่งั้น build บนคลาวด์จะ fail ตอน npm install)
legacy-peer-deps=true
