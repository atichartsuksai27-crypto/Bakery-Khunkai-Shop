{
  "name": "bakery-khunkai-shop",
  "private": true,
  "version": "1.0.0",
  "description": "ระบบสูตรและต้นทุนขนม Bakery Khunkai — Cloudflare Pages + D1 (ใช้ภายในองค์กร)",
  "scripts": {
    "dev": "node server.js",
    "pages:dev": "wrangler pages dev . --d1=DB",
    "db:create": "wrangler d1 create bakery-khunkai-db",
    "db:migrate": "wrangler d1 execute bakery-khunkai-db --remote --file=migrations/0001_init.sql",
    "db:migrate:local": "wrangler d1 execute bakery-khunkai-db --local --file=migrations/0001_init.sql",
    "deploy": "wrangler pages deploy . --project-name=bakery-khunkai-shop"
  },
  "devDependencies": {
    "wrangler": "^4.120.0"
  }
}
